    "stripe": "^14.21.0",
    "@stripe/react-stripe-js": "^2.7.0",
    "openai": "^4.38.0",
    "framer-motion": "^10.16.16",
    "lottie-react": "^2.4.0",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0",
    "zustand": "^4.4.6",
    "clsx": "^2.0.0",
